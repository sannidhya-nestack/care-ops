# OpenAI — optional. Without it, CareOps AI uses curated mock responses.
OPENAI_API_KEY=
# Chat model (default gpt-4o)
AI_MODEL=gpt-4o
# Embedding model for Ops Copilot retrieval
EMBED_MODEL=text-embedding-3-small

# Hugging Face — optional. Without it, Install Copilot uses SVG blueprint fallback.
HUGGINGFACE_API_KEY=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Demo auth — login credentials for the gate. Client-side (NEXT_PUBLIC_), set at build time.
# Defaults to demo@careops.ai / careops123 if unset.
NEXT_PUBLIC_LOGIN_ID=demo@careops.ai
NEXT_PUBLIC_LOGIN_PASS=careops123
